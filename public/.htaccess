# DevForge — Apache config for the static export (`npm run build:static`, upload ./out)

Options -Indexes -MultiViews
DirectorySlash On
ServerSignature Off
FileETag None

# Block dotfiles (.git, .env, .htpasswd…) except /.well-known, plus backups and source maps
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(map|bak|old|orig|swp|sql|log|ini|sh|env)$ - [F,L,NC]
  # Only GET/HEAD make sense on a static site
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|OPTIONS)$
  RewriteRule .* - [R=405,L]
</IfModule>

# Next.js static export: /tools/<id>/ is a folder with index.html; unknown paths get the 404 page
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # /tools/foo → /tools/foo/ (trailingSlash export)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

# MIME Types
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/wasm .wasm
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
  # Cross-origin isolation: enables SharedArrayBuffer / multi-threaded WASM (background removal)
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  # X-XSS-Protection is deprecated; explicitly disable the legacy auditor
  Header always set X-XSS-Protection "0"
  # HTTPS only for a year (Cloudflare terminates TLS; this tells browsers never to try http://)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
  # Content-Security-Policy. Every HTML page ALSO carries a stricter per-page <meta> CSP with
  # SHA-256 hashes of its inline scripts (scripts/harden-static.mjs); browsers enforce both,
  # so 'unsafe-inline' here is neutralised for scripts.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' https: data: blob:; frame-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; upgrade-insecure-requests"
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/wasm image/svg+xml
</IfModule>

# Cache Control — hashed build assets are immutable, HTML always revalidates
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|wasm|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
